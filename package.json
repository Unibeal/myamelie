{
  "nom": "my-amelie",
  "version": "1.0.0",
  "description": "MY AMELIE — mon tableau de révisions, en plus simple qu'Excel",
  "main": "main.js",
  "auteur" : "MY AMELIE",
  "licence" : "SANS LICENCE",
  "privé" : vrai,
  "scripts": {
    "début": "électron .",
    "dist": "electron-builder --win --mac --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "électron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "construire": {
    "appId": "com.myamelie.app",
    "nom_du_produit": "MY AMELIE",
    "publier" : null,
    "fichiers" : [
      "main.js",
      "app/**/*",
      "build/icon.png"
    ],
    "répertoires" : {
      "sortie": "libération"
    },
    "gagner": {
      "icône": "build/icon.ico",
      "cible": [
        { "cible": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick" : faux,
      "autoriserLaModificationDuRépertoireD'Installation": vrai,
      "createDesktopShortcut": vrai,
      "createStartMenuShortcut": vrai
    },
    "mac": {
      "icône": "build/icon.icns",
      "cible" : "dmg" ,
      "catégorie": "public.app-category.education"
    },
    "linux": {
      "icône": "build/icon.png",
      "cible" : ["AppImage"],
      "catégorie" : "Éducation"
    }
  }
}
